#include "../Skip.env"

// The iOS app is Example.app, the host of ExampleTests. Skip.env's PRODUCT_NAME names the shared
// Swift module, which the Android build needs.
PRODUCT_NAME = Example

// The Xcode "Run skip gradle" phase builds the Android app too.
// "launch" builds it and runs it on the first open Android emulator or device,
// "build" only builds it, and "none" skips Android entirely (also SKIP_ZERO=1 in the environment).
SKIP_ACTION = launch
//SKIP_ACTION = build
//SKIP_ACTION = none

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

INFOPLIST_FILE = Example/Example-Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_NSLocationWhenInUseUsageDescription = We need your location to show it on the map.
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight

IPHONEOS_DEPLOYMENT_TARGET = 17.0
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
TARGETED_DEVICE_FAMILY = 1,2

// The app target's own module; it cannot share the name of the DebugSwiftExample module.
PRODUCT_MODULE_NAME = ExampleApp

SWIFT_VERSION = 6.0

CODE_SIGN_ENTITLEMENTS = Example/Example.entitlements
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM =
PROVISIONING_PROFILE_SPECIFIER =
